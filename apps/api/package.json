{
  "name": "@repp/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:rls": "psql \"$MIGRATION_DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/sql/rls-policies.sql",
    "db:setup": "npm run db:migrate && npm run db:rls",
    "migration:gen": "node scripts/gen-migration.mjs",
    "test:e2e": "node test/e2e/run-e2e.mjs",
    "test:e2e:http": "node test/e2e/run-e2e-http.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^5.22.0",
    "@repp/shared": "*",
    "@signpdf/placeholder-plain": "^3.2.4",
    "@signpdf/signer-p12": "^3.2.4",
    "@signpdf/signpdf": "^3.2.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "node-forge": "^1.3.1",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.1",
    "@types/node-forge": "^1.3.11",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.22.0",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
