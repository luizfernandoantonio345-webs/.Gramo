# =============================================================================
# REP-P - Exemplo de variaveis de ambiente. Copie para .env e ajuste.
# NUNCA versione o arquivo .env real (contem segredos). Ver .gitignore.
# =============================================================================

# --- Banco de dados (PostgreSQL) -------------------------------------------
# Modelo de DUAS roles (essencial para o RLS funcionar):
#   repp_owner : dona do banco, roda migrations e o DDL de RLS.
#   repp_app   : role NOSUPERUSER que a API usa (RLS aplicado a ela).
POSTGRES_USER=repp_owner
POSTGRES_PASSWORD=troque_a_senha_do_owner
POSTGRES_APP_PASSWORD=troque_a_senha_do_app
POSTGRES_SUPER_PASSWORD=troque_a_senha_do_super
POSTGRES_DB=repp
POSTGRES_PORT=5432

# Conexao da APLICACAO (role sem superuser -> RLS ativo).
DATABASE_URL=postgresql://repp_app:troque_a_senha_do_app@localhost:5432/repp?schema=public
# Conexao do SUPER ADMIN/plataforma (role sem acesso a dados operacionais).
SUPER_DATABASE_URL=postgresql://repp_super:troque_a_senha_do_super@localhost:5432/repp?schema=public
# Conexao para MIGRATIONS/DDL (owner). Usada por `prisma migrate` e `db:rls`.
MIGRATION_DATABASE_URL=postgresql://repp_owner:troque_a_senha_do_owner@localhost:5432/repp?schema=public

# --- API (NestJS) -----------------------------------------------------------
API_PORT=3000
WEB_PORT=8080
NODE_ENV=development

# CORS: origens permitidas do PWA (separadas por virgula). Vazio em producao = nega.
# Ex.: CORS_ORIGINS=https://empresax.seuapp.com,https://app.seuapp.com
CORS_ORIGINS=

# --- E-mail (SMTP) ----------------------------------------------------------
# Sem SMTP_HOST, os e-mails (recuperacao/convite) sao apenas registrados no log.
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=senha
# SMTP_FROM=no-reply@suaempresa.com

# --- Autenticacao -----------------------------------------------------------
# Gere segredos fortes: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET=troque_este_segredo_de_access_token
JWT_REFRESH_SECRET=troque_este_segredo_de_refresh_token
JWT_ACCESS_TTL=900        # 15 min (curto de proposito; ver offline-first)
JWT_REFRESH_TTL=2592000   # 30 dias

# --- Criptografia de dados sensiveis (LGPD - biometria em repouso, AES-256) --
# Chave de 32 bytes em base64. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=troque_por_uma_chave_aes256_base64

# --- Assinatura virtual (Ed25519) --------------------------------------------
# Seed de 32 bytes (base64) da chave de assinatura do servidor. OPCIONAL:
# se ausente, e derivada por HKDF de DATA_ENCRYPTION_KEY (separacao de chave).
# Em producao, defina uma seed dedicada e faca backup seguro (a chave publica
# correspondente e usada para verificar comprovantes de assinatura).
# ASSINATURA_SEED=troque_por_uma_seed_ed25519_base64

# --- Armazenamento de arquivos (fotos, documentos) --------------------------
# STORAGE_DRIVER=local (filesystem cifrado) | s3 (Cloudflare R2 / AWS S3).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Para STORAGE_DRIVER=s3 (ex.: Cloudflare R2) -- requer `npm i @aws-sdk/client-s3`:
# STORAGE_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# STORAGE_S3_BUCKET=repp-arquivos
# STORAGE_S3_REGION=auto
# STORAGE_S3_KEY=...
# STORAGE_S3_SECRET=...

# --- Frontend (Vite) --------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
